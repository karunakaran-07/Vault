# ── Server ──────────────────────────────────────────────────
PORT=5000

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d

# ── Uploads ──────────────────────────────────────────────────
MAX_FILE_SIZE_MB=5

# ── Email (Gmail) for Forgot Password OTP ────────────────────

EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16char_app_password
EMAIL_FROM=DocVault <your_gmail@gmail.com>

